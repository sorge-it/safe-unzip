{
    "name": "sorge-it/safe-unzip",
    "description": "Extracts ZIP files in PHP and checks them against a strict allow list before it writes a byte. Refuses Zip Slip (path traversal), overlapping zip bombs, symbolic links and names outside the list. Limits entries and bytes, keeps the executable bit, names the rule in an exception, needs Info-ZIP, not ext-zip. For code that AI coding agents write.",
    "type": "library",
    "license": "MIT",
    "keywords": ["zip", "unzip", "ziparchive", "extract", "archive", "zip-slip", "path-traversal", "zip-bomb", "symlink", "unix-permissions", "executable-bit", "security", "info-zip", "ai-agents", "coding-agents"],
    "homepage": "https://github.com/sorge-it/safe-unzip",
    "authors": [
        {
            "name": "Stefan Sorge",
            "homepage": "https://github.com/sorge-it"
        }
    ],
    "support": {
        "source": "https://github.com/sorge-it/safe-unzip",
        "docs": "https://github.com/sorge-it/safe-unzip#readme",
        "security": "https://github.com/sorge-it/safe-unzip/security/policy"
    },
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "ext-zip": "*",
        "laravel/pint": "^1.29",
        "pestphp/pest": "^4.7|^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0.5|^5.1.1",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.8.5"
    },
    "autoload": {
        "psr-4": {
            "SorgeIt\\SafeUnzip\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SorgeIt\\SafeUnzip\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ],
        "test:unit": "pest",
        "test:types": "phpstan",
        "test:type-coverage": "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100 --no-cache --configuration=phpunit.type-coverage.xml",
        "test:coverage": "@php -d memory_limit=1G vendor/bin/pest --coverage --min=100",
        "test:lint": [
            "pint --test",
            "rector --dry-run"
        ],
        "lint": [
            "rector",
            "pint"
        ]
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "lock": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
